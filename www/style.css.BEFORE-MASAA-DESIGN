    display: grid;
    place-items: center;
    border-radius: 17px;
    background: #f8e4ec;
    font-size: 25px;
}

.journey-day-info {
    min-width: 0;
}

.journey-day-number {
    display: block;
    margin-bottom: 3px;
    color: #a15b78;
    font-size: 12px;
    font-weight: 700;
}

.journey-day-info h3 {
    margin: 0;
