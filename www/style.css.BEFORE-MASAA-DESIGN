    font-size: 19px;
    line-height: 1.4;
}

.journey-date {
    display: block;
    margin-top: 3px;
    color: #8c747e;
    font-size: 12px;
}

.journey-description {
    margin: 0 0 17px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(248, 228, 236, .45);
    color: #765e69;
    font-size: 13px;
    line-height: 1.8;
}

.journey-progress {
    margin-bottom: 17px;
}

.journey-progress-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 7px;
    color: #765e69;
    font-size: 12px;
}

.journey-progress-top strong {
    color: #8d3f60;
}

.journey-progress-bar {
    width: 100%;
    height: 8px;
    overflow: hidden;
    border-radius: 20px;
    background: #f2e5ea;
}

.journey-progress-fill {
    height: 100%;
    border-radius: inherit;
    background: #b96888;
    transition: width .35s ease;
}

.journey-tasks {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.journey-task {
    width: 100%;
    min-height: 48px;
    padding: 9px 11px;
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1px solid rgba(169, 87, 120, .10);
    border-radius: 15px;
    background: #fff;
    color: #5f4853;
    font-family: inherit;
    font-size: 13px;
    text-align: right;
    cursor: pointer;
    transition: .2s ease;
}

.task-check {
    width: 27px;
    height: 27px;
    flex: 0 0 27px;
    display: grid;
    place-items: center;
    border: 2px solid #dfc4cf;
    border-radius: 9px;
    color: white;
    font-size: 14px;
    font-weight: 800;
}

.task-text {
    flex: 1;
    line-height: 1.6;
}

.journey-task.completed {
    background: #f8e8ef;
    border-color: #e7c2d0;
}

.journey-task.completed .task-check {
    border-color: #a95778;
    background: #a95778;
}

.journey-task.completed .task-text {
    color: #8b6676;
    text-decoration: line-through;
}

.journey-task:active {
    transform: scale(.985);
}


