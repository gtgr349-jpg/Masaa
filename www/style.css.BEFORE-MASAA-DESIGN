/* =========================================================
   AYOUSHTI — PREMIUM MOBILE UI
   ========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
}

:root {
    --bg: #fff8fb;
    --surface: rgba(255, 255, 255, 0.88);
    --surface-solid: #ffffff;

    --primary: #a95778;
    --primary-dark: #8d3f60;
    --primary-soft: #f6e5ec;

    --text: #4b3a42;
    --text-soft: #8d7b83;

    --border: rgba(169, 87, 120, 0.10);

    --shadow:
        0 14px 40px rgba(110, 58, 78, 0.09);

    --radius: 24px;
}

html {
    min-height: 100%;
    background: var(--bg);
}

body {
    min-height: 100vh;
    font-family:
        "Segoe UI",
        Tahoma,
        Arial,
        sans-serif;

    color: var(--text);

    background:
        radial-gradient(
            circle at 100% 0%,
            rgba(246, 220, 231, 0.65),
            transparent 32%
        ),
        radial-gradient(
            circle at 0% 45%,
            rgba(255, 235, 242, 0.75),
            transparent 30%
        ),
        linear-gradient(
            180deg,
            #fffafd 0%,
            #fff7fa 55%,
            #fff3f7 100%
        );
}


/* =========================================================
   APP
   ========================================================= */

.app {
    width: 100%;
    max-width: 520px;

    min-height: 100vh;

    margin: auto;
    padding:
        max(18px, env(safe-area-inset-top))
        17px
        max(28px, env(safe-area-inset-bottom));

    overflow: hidden;
}


/* =========================================================
   HEADER
   ========================================================= */

.header {
    position: relative;

    padding: 12px 4px 22px;

    text-align: right;
}

.header-top {
    display: flex;
    align-items: center;
    gap: 14px;
}

.logo {
    width: 58px;
    height: 58px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 20px;

    font-size: 28px;

    background:
        linear-gradient(
            145deg,
            #fff,
            #f8e5ed
        );

    border: 1px solid rgba(169, 87, 120, .08);

    box-shadow:
        0 10px 28px rgba(120, 62, 84, .10);
}

.header-text {
    min-width: 0;
}

.welcome-text {
    display: block;

    margin-bottom: 2px;

    color: var(--text-soft);

    font-size: 12px;
    font-weight: 600;
}

.header h1 {
    font-size: 28px;
    line-height: 1.1;

    font-weight: 900;

    color: var(--primary-dark);
}

.header p {
    margin-top: 5px;

    color: var(--text-soft);

    font-size: 12px;
}

.header-decoration {
    position: absolute;

    left: 5px;
    bottom: 13px;

    color: #d79ab3;

    font-size: 17px;

    opacity: .7;
}


/* =========================================================
   TRIP CARD
   ========================================================= */

.trip-card {
    position: relative;

    overflow: hidden;

    min-height: 185px;

    padding: 20px;

    border-radius: 30px;

    color: white;

    background:
        linear-gradient(
            145deg,
            #b86688 0%,
            #a14d70 48%,
            #873d5e 100%
        );

    box-shadow:
        0 20px 45px rgba(145, 65, 94, .22);

    margin-bottom: 15px;
}

.trip-card::before {
    content: "";

    position: absolute;

    width: 190px;
    height: 190px;

    top: -100px;
    left: -70px;

    border-radius: 50%;

    background: rgba(255,255,255,.09);
}

.trip-card::after {
    content: "";

    position: absolute;

    width: 130px;
    height: 130px;

    bottom: -70px;
    right: -35px;

    border-radius: 50%;

    background: rgba(255,255,255,.07);
}

.trip-glow {
    position: absolute;

    width: 150px;
    height: 150px;

    top: -60px;
    right: -35px;

    border-radius: 50%;

    background: rgba(255,255,255,.08);

    filter: blur(2px);
}

.trip-top {
    position: relative;
    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.trip-icon-wrapper {
    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border-radius: 16px;

    background: rgba(255,255,255,.15);

    border: 1px solid rgba(255,255,255,.15);

    backdrop-filter: blur(10px);
}

.trip-icon {
    font-size: 24px;
}

.trip-status-label {
    padding: 7px 12px;

    border-radius: 20px;

    font-size: 11px;
    font-weight: 700;

    background: rgba(255,255,255,.14);

    border: 1px solid rgba(255,255,255,.13);
}

.trip-content {
    position: relative;
    z-index: 2;

    margin-top: 17px;
}

.trip-card h2 {
    font-size: 21px;
    font-weight: 900;

    color: #fff;

    margin-bottom: 7px;
}

.trip-day {
    display: inline-block;

    padding: 5px 10px;

    border-radius: 10px;

    background: rgba(255,255,255,.13);

    font-size: 12px;
    font-weight: 700;
}

.trip-message {
    margin-top: 11px;

    max-width: 90%;

    font-size: 12px;
    line-height: 1.8;

    color: rgba(255,255,255,.88);
}

.trip-stars {
    position: absolute;

    left: 18px;
    bottom: 14px;

    font-size: 10px;

    color: rgba(255,255,255,.55);

    z-index: 2;
}


/* =========================================================
   MESSAGE CARD
   ========================================================= */

.message-card {
    position: relative;

    padding: 19px;

    border-radius: var(--radius);

    background: rgba(255,255,255,.9);

    border: 1px solid var(--border);

    box-shadow: var(--shadow);

    margin-bottom: 13px;
}

.message-header {
    display: flex;
    align-items: center;

    gap: 11px;
}

.message-icon {
    width: 43px;
    height: 43px;

    display: grid;
    place-items: center;

    border-radius: 15px;

    background: var(--primary-soft);

    font-size: 20px;
}

.message-header span {
    display: block;

    color: #b58c9d;

    font-size: 10px;
    font-weight: 700;
}

.message-header h3 {
    margin-top: 2px;

    color: var(--primary-dark);

    font-size: 15px;
    font-weight: 900;
}

.message-divider {
    height: 1px;

    margin: 15px 0 13px;

    background: linear-gradient(
        90deg,
        transparent,
        #efdbe3,
        transparent
    );
}

.message-card p {
    color: #76636c;

    font-size: 13px;
    line-height: 2;

    text-align: right;
}

.message-signature {
    margin-top: 10px;

    color: var(--primary);

    font-size: 11px;
    font-weight: 700;

    text-align: left;
}


/* =========================================================
   NOTIFICATION
   ========================================================= */

.notification-button {
    width: 100%;

    min-height: 52px;

    display: flex !important;
    align-items: center;
    justify-content: center;

    gap: 9px;

    border: 0;

    border-radius: 18px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #b55f82,
            #984866
        );

    box-shadow:
        0 12px 25px rgba(151, 68, 99, .18);

    font-size: 13px;
    font-weight: 800;

    cursor: pointer;

    transition:
        transform .18s ease,
        box-shadow .18s ease;
}

.notification-button:active {
    transform: scale(.98);

    box-shadow:
        0 7px 15px rgba(151, 68, 99, .15);
}

.notification-icon {
    font-size: 17px;
}

.button-arrow {
    position: absolute;

    opacity: .6;

    margin-right: 185px;
}


/* =========================================================
   MENU
   ========================================================= */

.menu {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 11px;

    margin-top: 25px;
}

.home-section-heading {
    grid-column: 1 / -1;

    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 2px 3px 5px;
}

.home-section-heading span {
    color: #b28a9b;

    font-size: 10px;
    font-weight: 700;
}

.home-section-heading h2 {
    margin-top: 3px;

    color: var(--text);

    font-size: 18px;
    font-weight: 900;
}

.heading-star {
    width: 37px;
    height: 37px;

    display: grid;
    place-items: center;

    border-radius: 13px;

    color: #c985a2;

    background: #f9eaf0;

    font-size: 16px;
}


/* =========================================================
   MENU BUTTONS
   ========================================================= */

.menu button {
    position: relative;

    min-height: 92px;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 13px;

    border: 1px solid rgba(169,87,120,.07);

    border-radius: 22px;

    background: rgba(255,255,255,.88);

    box-shadow:
        0 9px 25px rgba(110,58,78,.065);

    color: var(--text);

    text-align: right;

    cursor: pointer;

    overflow: hidden;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease;
}

.menu button::after {
    content: "";

    position: absolute;

    width: 70px;
    height: 70px;

    left: -28px;
    bottom: -35px;

    border-radius: 50%;

    background: rgba(247,225,234,.45);
}

.menu button:active {
    transform: scale(.97);

    box-shadow:
        0 5px 14px rgba(110,58,78,.08);
}

.menu-icon {
    position: relative;
    z-index: 2;

    width: 47px;
    height: 47px;

    flex-shrink: 0;

    display: grid;
    place-items: center;

    border-radius: 16px;

    font-size: 21px;
}

.umrah-icon {
    background: #f5e7ec;
}

.dua-icon {
    background: #f9efe0;
}

.journey-icon {
    background: #e9f1ed;
}

.rating-icon {
    background: #f7efdb;
}

.message-menu-icon {
    background: #f5e5ed;
}

.menu-text {
    position: relative;
    z-index: 2;

    min-width: 0;

    flex: 1;

    display: flex;

    flex-direction: column;

    gap: 4px;
}

.menu-text strong {
    color: #55434b;

    font-size: 14px;

    font-weight: 900;
}

.menu-text span {
    color: #9a8990;

    font-size: 10px;

    line-height: 1.5;
}

.menu-arrow {
    position: relative;
    z-index: 2;

    color: #c394a7;

    font-size: 15px;

    opacity: .75;
}

.menu-wide {
    grid-column: 1 / -1;

    min-height: 78px !important;
}


/* =========================================================
   HOME NOTE
   ========================================================= */

.home-note {
    grid-column: 1 / -1;

    display: flex;

    align-items: center;

    gap: 11px;

    margin-top: 4px;

    padding: 14px;

    border-radius: 20px;

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.88),
            rgba(250,237,243,.72)
        );

    border: 1px solid rgba(169,87,120,.06);
}

.home-note-icon {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    display: grid;
    place-items: center;

    border-radius: 13px;

    background: white;

    box-shadow: 0 5px 14px rgba(110,58,78,.06);
}

.home-note strong {
    display: block;

    color: #735665;

    font-size: 11px;
}

.home-note p {
    margin-top: 3px;

    color: #a18f96;

    font-size: 10px;
}


/* =========================================================
   PAGE SECTIONS
   ========================================================= */

.hidden {
    display: none !important;
}

.page-section {
    animation: pageEnter .3s ease both;

    padding-top: 5px;
}

@keyframes pageEnter {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.page-section h2 {
    margin-top: 22px;

    color: var(--primary-dark);

    font-size: 25px;
    font-weight: 900;
}

.section-subtitle {
    margin-top: 6px;

    color: var(--text-soft);

    font-size: 12px;
}


/* =========================================================
   BACK BUTTON
   ========================================================= */

.back-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 43px;

    padding: 0 15px;

    border: 0;

    border-radius: 15px;

    color: var(--primary-dark);

    background: #f7e8ee;

    font-size: 12px;
    font-weight: 800;

    cursor: pointer;
}

.back-button:active {
    transform: scale(.97);
}


/* =========================================================
   JOURNEY
   ========================================================= */

.journey-card {
    position: relative;

    padding: 16px;

    margin-top: 12px;

    border-radius: 21px;

    background: white;

    border: 1px solid var(--border);

    box-shadow: 0 9px 25px rgba(110,58,78,.06);
}

.journey-header {
    display: flex;
    align-items: center;

    gap: 11px;
}

.journey-icon {
    width: 43px;
    height: 43px;

    display: grid;
    place-items: center;

    border-radius: 14px;

    background: #f6e7ed;
}

.journey-status {
    margin-right: auto;

    padding: 5px 9px;

    border-radius: 10px;

    color: #9b637b;

    background: #faedf2;

    font-size: 9px;
    font-weight: 800;
}


/* =========================================================
   UMRAH
   ========================================================= */

.umrah-header {
    padding: 18px;

    border-radius: 24px;

    background: white;

    box-shadow: var(--shadow);

    margin-top: 15px;
}

.umrah-icon {
    font-size: 30px;
}

.umrah-progress {
    display: flex;

    align-items: center;

    margin: 20px 0;
}

.progress-item {
    flex: 1;

    text-align: center;

    color: #a88b97;

    font-size: 10px;
}

.progress-line {
    height: 2px;

    flex: 1;

    background: #ead9e1;
}

.umrah-step-card {
    padding: 19px;

    margin-top: 13px;

    border-radius: 23px;

    background: white;

    border: 1px solid var(--border);

    box-shadow: 0 9px 27px rgba(110,58,78,.06);
}

.info-box,
.talbiyah,
.dua,
.note,
.important {
    margin-top: 12px;

    padding: 14px;

    border-radius: 17px;

    font-size: 12px;

    line-height: 1.9;
}

.info-box {
    background: #f4f8f6;
}

.talbiyah {
    background: #f8edf2;
}

.dua {
    background: #fbf5e8;
}

.note {
    background: #f3f5f8;
}

.important {
    background: #fff0f0;
}


/* =========================================================
   TAWAF / SAI
   ========================================================= */

.tawaf-counter {
    margin-top: 16px;

    padding: 25px;

    text-align: center;

    border-radius: 25px;

    background:
        linear-gradient(
            145deg,
            #fff,
            #faedf2
        );

    box-shadow: var(--shadow);
}

.counter-title {
    color: var(--text-soft);

    font-size: 12px;
}

.counter-number {
    margin: 8px 0;

    color: var(--primary-dark);

    font-size: 50px;
    font-weight: 900;
}

.counter-total {
    color: #a9909b;

    font-size: 11px;
}

.tawaf-dots {
    display: flex;

    justify-content: center;

    gap: 7px;

    margin-top: 17px;
}

.tawaf-dots span {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #e7d4dd;
}

.tawaf-dots span.active {
    background: var(--primary);
}

.completion-card {
    margin-top: 18px;

    padding: 25px;

    text-align: center;

    border-radius: 25px;

    background: white;

    box-shadow: var(--shadow);
}

.completion-icon {
    font-size: 38px;
}

.special-message {
    margin-top: 12px;

    color: var(--text-soft);

    font-size: 12px;

    line-height: 1.9;
}

.sai-route {
    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    margin: 20px 0;
}

.sai-point {
    padding: 11px 14px;

    border-radius: 14px;

    background: #f7e8ee;

    color: var(--primary-dark);

    font-size: 11px;
    font-weight: 800;
}

.sai-arrow {
    color: #b993a3;
}


/* =========================================================
   FOOTER
   ========================================================= */

footer {
    padding: 28px 0 8px;

    text-align: center;

    color: #b29ba5;

    font-size: 10px;
}

footer strong {
    color: var(--primary);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 390px) {

    .app {
        padding-left: 13px;
        padding-right: 13px;
    }

    .header h1 {
        font-size: 25px;
    }

    .trip-card {
        min-height: 175px;

        padding: 17px;
    }

    .trip-card h2 {
        font-size: 19px;
    }

    .menu {
        gap: 9px;
    }

    .menu button {
        min-height: 88px;

        padding: 11px;

        border-radius: 19px;
    }

    .menu-icon {
        width: 43px;
        height: 43px;

        border-radius: 14px;
    }

    .menu-text strong {
        font-size: 13px;
    }

    .menu-text span {
        font-size: 9px;
    }
}


/* =========================================================
   REDUCE MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
    }
}
/* =========================
   ?? SETTINGS BUTTON
   ========================= */

.header {
    position: relative;
}

.header-actions {
    position: absolute;
    top: 8px;
    left: 0;
    z-index: 10;
}

.header-settings {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border: 1px solid rgba(169, 87, 120, .10);
    border-radius: 14px;

    background: rgba(255, 255, 255, .88);

    color: #8d3f60;
    font-size: 19px;

    box-shadow:
        0 8px 22px rgba(110, 58, 78, .10);

    backdrop-filter: blur(10px);

    cursor: pointer;

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        background .2s ease;
}

.header-settings:active {
    transform: scale(.91) rotate(8deg);

    box-shadow:
        0 4px 12px rgba(110, 58, 78, .08);
}


/* =========================================================
   ⚙️ AYOUSHTI SETTINGS
   ========================================================= */

.settings-card {
    margin-top: 13px;
    padding: 17px;
    border-radius: 22px;

    background: rgba(255, 255, 255, .90);

    border: 1px solid rgba(169, 87, 120, .08);

    box-shadow:
        0 10px 28px rgba(110, 58, 78, .065);
}

.settings-title {
    display: flex;
    align-items: center;
    gap: 12px;
}

.settings-icon {
    width: 45px;
    height: 45px;

    flex-shrink: 0;

    display: grid;
    place-items: center;

    border-radius: 15px;

    background: #f7e8ee;

    font-size: 20px;
}

.settings-title strong {
    display: block;

    color: #5b4650;

    font-size: 14px;
    font-weight: 900;
}

.settings-title span {
    display: block;

    margin-top: 4px;

    color: #9b8991;

    font-size: 10px;
}

.settings-button,
.settings-danger {
    width: 100%;

    min-height: 46px;

    margin-top: 14px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 14px;

    border: 0;
    border-radius: 15px;

    font-family: inherit;

    font-size: 11px;
    font-weight: 800;

    cursor: pointer;

    transition:
        transform .18s ease,
        box-shadow .18s ease;
}

.settings-button {
    color: #8d3f60;
    background: #f8eaf0;
}

.settings-danger {
    color: #a65b67;
    background: #fff0f1;
}

.settings-button:active,
.settings-danger:active {
    transform: scale(.97);
}

.settings-option {
    min-height: 45px;

    margin-top: 13px;

    padding: 0 14px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-radius: 15px;

    color: #7c6871;
    background: #faf5f7;

    font-size: 11px;
    font-weight: 700;
}

.settings-option.active {
    color: #8d3f60;

    background: #f8e8ef;

    border: 1px solid rgba(169, 87, 120, .08);
}

.font-options {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 7px;

    margin-top: 13px;
}

.font-options button {
    min-height: 42px;

    border: 1px solid rgba(169, 87, 120, .07);

    border-radius: 13px;

    background: #faf7f8;

    color: #8e7c84;

    font-family: inherit;

    font-size: 10px;
    font-weight: 800;

    cursor: pointer;

    transition:
        transform .18s ease,
        background .18s ease;
}

.font-options button:active {
    transform: scale(.95);
}

.font-options button.active {
    color: white;

    background:
        linear-gradient(
            135deg,
            #b55f82,
            #984866
        );

    border-color: transparent;
}

.settings-about {
    margin-top: 14px;

    color: #76636c;

    font-size: 11px;

    line-height: 2;

    text-align: right;
}

.settings-signature {
    margin-top: 11px;

    color: #b06b87;

    font-size: 10px;

    font-weight: 800;

    text-align: left;
}

/* =========================================================
   🔤 FONT SIZE SETTINGS
   ========================================================= */

html.font-small .app {
    zoom: 0.94;
}

html.font-normal .app {
    zoom: 1;
}

html.font-large .app {
    zoom: 1.08;
}

/* =========================================================
   🌙 THEME OPTIONS
   ========================================================= */

.theme-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
}

.theme-options .settings-option {
    width: 100%;
    min-height: 52px;
