/* =========================================================
   AYOSHTI - QURAN
   ========================================================= */

#quranSection {
    width: 100%;
    box-sizing: border-box;
    padding-bottom: 30px;
}

#quranContent {
    width: 100%;
    box-sizing: border-box;
    margin-top: 18px;
}

.quran-toolbar {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 18px;
}

.quran-surahs {
    width: 100%;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.quran-surah-card {
    width: 100%;
    min-height: 72px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border: 1px solid rgba(169,87,120,.08);
    border-radius: 18px;
    background: rgba(255,255,255,.92);
    color: var(--text);
    text-align: right;
    box-shadow: 0 7px 20px rgba(110,58,78,.055);
}

.quran-surah-number {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: #f7e9ef;
    color: #a95c7d;
    font-size: 12px;
    font-weight: 900;
}

.quran-surah-name {
    min-width: 0;
    flex: 1;
    color: #55434b;
    font-size: 13px;
    font-weight: 900;
}

.quran-reader {
    width: 100%;
    box-sizing: border-box;
}

.quran-ayah {
    width: 100%;
    box-sizing: border-box;
    padding: 24px 18px;
    margin-bottom: 18px;
    border-radius: 22px;
    background: rgba(255,255,255,.94);
    box-shadow: 0 9px 25px rgba(110,58,78,.065);
    color: #4f3d45;
    font-size: 21px;
    line-height: 2.2;
    text-align: center;
    direction: rtl;
}

.quran-controls {
    width: 100%;
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
}

.quran-controls button {
    min-height: 44px;
    padding: 10px 16px;
    border: 0;
    border-radius: 15px;
    background: #f4e4eb;
    color: #8f506b;
    font-weight: 800;
}

.quran-last-position {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 15px;
    margin-bottom: 15px;
    border-radius: 17px;
    background: #faf1f5;
    color: #8f6877;
    text-align: right;
    font-size: 12px;
}

@media (max-width: 480px) {
    .quran-surahs {
        grid-template-columns: 1fr;
    }

    .quran-ayah {
        font-size: 19px;
        line-height: 2.15;
        padding: 21px 15px;
    }
}


/* =========================================================
   AYOSHTI — FINAL QURAN DESIGN
   ========================================================= */

#quranSection {
    width: 100%;
    box-sizing: border-box;
}

#quranContent {
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
}

/* ---------- Quran Home ---------- */

.quran-home {
    width: 100%;
}

.quran-reading-resume {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px 20px;
    margin-bottom: 25px;
    border-radius: 22px;
    background: linear-gradient(135deg, #fff8fb, #f8f1f6);
    border: 1px solid rgba(169, 92, 125, .16);
    box-shadow: 0 8px 25px rgba(80, 40, 60, .07);
}

.quran-resume-symbol {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
    color: #A95C7D;
    font-size: 25px;
    box-shadow: 0 4px 15px rgba(80, 40, 60, .08);
}

.quran-resume-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.quran-resume-info span {
    font-size: 12px;
    color: #9a7b89;
}

.quran-resume-info strong {
    color: #563746;
    font-size: 18px;
}

.quran-resume-info small {
    color: #9a7b89;
}

.quran-resume-button {
    border: 0;
    border-radius: 14px;
    padding: 11px 16px;
    background: #A95C7D;
    color: white;
    font-weight: 700;
    cursor: pointer;
}

.quran-resume-button span {
    margin-right: 5px;
}

.quran-section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 10px 4px 14px;
}

.quran-section-label span {
    font-size: 21px;
    font-weight: 800;
    color: #563746;
}

.quran-section-label small {
    color: #9a7b89;
}

/* ---------- Surah Grid ---------- */

.quran-surah-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
}

.quran-surah-card {
    position: relative;
    min-height: 104px;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 15px;
    border: 1px solid rgba(169, 92, 125, .13);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 6px 20px rgba(70, 35, 55, .06);
    color: #563746;
    cursor: pointer;
    text-align: right;
    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease;
}

.quran-surah-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(70, 35, 55, .11);
    border-color: rgba(169, 92, 125, .3);
}

.quran-surah-card:active {
    transform: scale(.97);
}

.quran-card-number {
    width: 45px;
    height: 45px;
    flex: 0 0 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #faf1f5;
    color: #A95C7D;
    font-weight: 800;
    font-size: 14px;
}

.quran-card-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.quran-card-content strong {
    font-size: 18px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.quran-card-content small {
    color: #a18491;
    font-size: 11px;
}

.quran-card-arrow {
    color: #C98AA5;
    font-size: 17px;
}

/* ---------- Reader ---------- */

.quran-reader {
    width: 100%;
}

.quran-reader-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
}

.quran-surah-title {
    flex: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.quran-surah-title span {
    font-size: 23px;
    font-weight: 800;
    color: #563746;
}

.quran-surah-title small {
    color: #9a7b89;
}

.quran-back-to-surahs {
    border: 0;
    background: transparent;
    color: #A95C7D;
    font-weight: 700;
    padding: 9px 4px;
    cursor: pointer;
}

/* ---------- Ayah Main Area ---------- */

.quran-ayah-card {
    position: relative;
    min-height: 430px;
    padding: 32px 28px 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-radius: 30px;
    background:
        radial-gradient(circle at top, rgba(217,143,175,.12), transparent 42%),
        #fff;
    border: 1px solid rgba(169,92,125,.13);
    box-shadow: 0 12px 35px rgba(70,35,55,.08);
    overflow: hidden;
}

.quran-tap-area {
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
}

.quran-ayah-top {
    position: absolute;
    top: 22px;
    right: 24px;
    left: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.quran-ayah-label {
    color: #b58b9d;
    font-size: 12px;
    font-weight: 700;
}

.quran-ayah-number {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #faf1f5;
    color: #A95C7D;
    font-weight: 800;
}

.quran-ayah-decoration {
    color: #D98FAF;
    font-size: 25px;
    margin-bottom: 18px;
}

.quran-ayah-text {
    width: 100%;
    max-width: 820px;
    text-align: center;
    direction: rtl;
    font-size: clamp(25px, 4vw, 38px);
    line-height: 2.25;
    color: #38252e;
    font-family: "Amiri", "Noto Naskh Arabic", "Traditional Arabic", serif;
}

.quran-tap-area:active .quran-ayah-text {
    transform: scale(.99);
}

.quran-tap-hint {
    margin-top: 28px;
    color: #b79aa7;
    font-size: 11px;
    opacity: .75;
}

/* ---------- Reader Controls ---------- */

.quran-reader-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
}

.quran-reader-controls button {
    min-height: 46px;
    padding: 10px 17px;
    border: 1px solid rgba(169,92,125,.15);
    border-radius: 15px;
    background: #fff;
    color: #694455;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(70,35,55,.05);
    transition: .18s ease;
}

.quran-reader-controls button:hover {
    border-color: rgba(169,92,125,.35);
    transform: translateY(-2px);
}

.quran-reader-controls button:nth-child(2) {
    background: #A95C7D;
    color: white;
    border-color: #A95C7D;
    min-width: 90px;
}

.quran-reader-controls button:disabled {
    opacity: .35;
    cursor: default;
    transform: none;
}

/* ---------- Mobile ---------- */

@media (max-width: 700px) {

    .quran-surah-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .quran-surah-card {
        min-height: 92px;
        padding: 12px;
        border-radius: 17px;
        gap: 9px;
    }

    .quran-card-number {
        width: 39px;
        height: 39px;
        flex-basis: 39px;
        border-radius: 12px;
    }

    .quran-card-content strong {
        font-size: 15px;
    }

    .quran-card-content small {
        font-size: 10px;
    }

    .quran-card-arrow {
        display: none;
    }

    .quran-reading-resume {
        padding: 14px;
    }

    .quran-resume-symbol {
        width: 45px;
        height: 45px;
        flex-basis: 45px;
    }

    .quran-resume-button {
        padding: 10px 12px;
    }

    .quran-ayah-card {
        min-height: 470px;
        padding: 55px 18px 25px;
        border-radius: 25px;
    }

    .quran-ayah-text {
        font-size: 25px;
        line-height: 2.15;
    }

    .quran-reader-controls {
        gap: 7px;
    }

    .quran-reader-controls button {
        flex: 1;
        padding: 10px 6px;
        font-size: 12px;
    }
}

@media (max-width: 380px) {

    .quran-surah-grid {
        grid-template-columns: 1fr;
    }

    .quran-reader-controls button {
        font-size: 11px;
    }
}


/* ================================
   AYOSHTI — NASHEEDS DESIGN
   ================================ */

#nasheedsSection {
    direction: rtl;
}

#nasheedsSection .section-subtitle {
    margin-bottom: 20px;
}

.nasheeds-player {
    width: 100%;
    box-sizing: border-box;
    background: #fff;
    border-radius: 22px;
    padding: 20px 16px;
    margin-bottom: 20px;
    box-shadow: 0 8px 25px rgba(169, 92, 125, 0.12);
    border: 1px solid rgba(169, 92, 125, 0.10);
}

.nasheed-cover {
    width: 82px;
    height: 82px;
    margin: 0 auto 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #D98FAF, #A95C7D);
    color: #fff;
    font-size: 34px;
    box-shadow: 0 8px 20px rgba(169, 92, 125, 0.22);
}

#nasheedTitle {
    text-align: center;
    font-size: 20px;
    font-weight: 800;
    color: #5f3d4d;
    margin: 8px 0 6px;
}

#nasheedCounter {
    text-align: center;
    font-size: 13px;
    color: #987582;
    margin-bottom: 12px;
}

#nasheedAudio {
    width: 100%;
    display: block;
    margin: 0 auto 16px;
}

.nasheed-buttons {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 8px;
    width: 100%;
}

.nasheed-buttons button,
.nasheed-modes button {
    border: 0;
    border-radius: 14px;
    padding: 11px 8px;
    font-family: inherit;
    font-weight: 700;
    font-size: 13px;
    background: #f8e9ef;
    color: #7b4b5e;
    cursor: pointer;
}

.nasheed-buttons button:hover,
.nasheed-modes button:hover {
    transform: translateY(-1px);
}

.nasheed-buttons button:active,
.nasheed-modes button:active {
    transform: scale(0.98);
}

.nasheed-modes {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    margin-top: 12px;
}

.nasheed-modes button.active {
    background: #D98FAF;
    color: #fff;
}

.nasheed-mode-text {
    text-align: center;
    margin: 14px 0 0;
    padding: 10px 12px;
    border-radius: 12px;
    background: #fff7fa;
    color: #8b6170;
    font-size: 12px;
    line-height: 1.7;
}

.nasheed-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
}

.nasheed-item {
    width: 100%;
    min-height: 48px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 13px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid #f1dfe6;
    color: #684653;
    font-size: 14px;
    font-weight: 600;
    text-align: right;
    overflow: hidden;
    cursor: pointer;
}

.nasheed-item::before {
    content: "🎵";
    flex: 0 0 auto;
}

.nasheed-item:hover {
    background: #fff7fa;
}

.nasheed-item.active {
    background: #f8e9ef;
    border-color: #D98FAF;
    color: #A95C7D;
}

.empty-state {
    text-align: center;
    padding: 25px 15px;
    color: #987582;
}

/* Mobile */
@media (max-width: 600px) {

    .nasheeds-player {
        padding: 17px 13px;
        border-radius: 19px;
    }

    #nasheedTitle {
        font-size: 18px;
    }

    .nasheed-buttons {
        grid-template-columns: 1fr 1.15fr 1fr;
    }

    .nasheed-buttons button,
    .nasheed-modes button {
        font-size: 12px;
        padding: 10px 5px;
        white-space: nowrap;
    }

    .nasheed-item {
        min-height: 50px;
        padding: 10px 12px;
        font-size: 13px;
    }
}
